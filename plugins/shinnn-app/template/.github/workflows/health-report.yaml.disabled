# 【無効】月次の健全性レポート
#
# このファイルは雛形です。拡張子 .disabled が付いている間、GitHub は読み込みません。
# 有効にするには /shinnn-app:setup を実行してください。
#
# 費用: 集計だけなら無料（Actions の無料枠内）。AI による要約を付ける場合のみ顧客負担。
# 効果: 毎月 1 日に、CI の通過率・受入条件のカバレッジ・滞留している Issue・
#       標準バージョンを Issue に投稿します。
# 入れない場合: 当社の月次フォローで同じ内容を手で確認します。
name: 月次の健全性レポート

on:
  schedule:
    - cron: '0 0 1 * *'
  workflow_dispatch:

permissions:
  contents: read
  issues: write

jobs:
  report:
    name: レポートの作成
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-node@v7
        with:
          node-version: '24'
          cache: npm

      - run: npm ci

      - name: 進捗スナップショットを作り直す
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: node scripts/progress-snapshot.mjs

      - name: 受入条件のカバレッジを集計する
        run: node scripts/check-ac-coverage.mjs --report > report-ac.md || true

      - name: Issue に投稿する
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          {
            echo '## 進捗スナップショット'
            echo
            cat docs/progress.md
            echo
            echo '## 受入条件のカバレッジ'
            echo
            cat report-ac.md
          } > report.md
          gh issue create --title "健全性レポート $(date +%Y-%m)" --body-file report.md --label 'report'
