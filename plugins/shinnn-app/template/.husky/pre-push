# main への push を止める。変更は作業ブランチから PR にする（.claude/rules/git-workflow.md）。
# GitHub にまだ main が無いとき（リポジトリを作った直後の最初の push）だけは通す。
# 標準入力の 1 行が送る ref 1 つ: <手元の ref> <手元のコミット> <送り先の ref> <送り先のコミット>
# 送り先に無い ref のコミットは 0 だけが並ぶ。
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    case "$remote_oid" in
      *[!0]*)
        echo "main には直接 push できません。作業ブランチ（feature/<Issue 番号>-<slug>）を切って PR にしてください。" >&2
        exit 1
        ;;
    esac
  fi
done
