# サーバーの環境変数の見本。`.env` にコピーして値を入れる（`.env` は git 管理外）。
# 名前と意味の一覧は docs/env.md にもある。値そのものはリポジトリに書かない。

# PostgreSQL への接続先。
DATABASE_URL=postgres://app:app@localhost:5432/app

# API サーバーが待ち受けるポート番号。
PORT=3000

# JWT（ログイン後に発行する署名付きの通行証）の署名鍵。32 文字以上のランダムな文字列にする。
JWT_SECRET=

# JWT の受け取り手を表す名前。トークンの aud クレームがこの値と一致しないと認証を通さない。
JWT_AUDIENCE=app-client

# 画面を配信するオリジン。複数あるときはカンマ区切り。`*` は使わない。
CORS_ORIGIN=http://localhost:4200

# 手前にリバースプロキシがあるとき、X-Forwarded-For をどこまで信頼するか。
# false（信頼しない） / true（すべて信頼。原則使わない） / 1 などの数値（手前の段数） / IP の一覧。
TRUST_PROXY=false

# 以下は省略できる（括弧内が既定値）。

# 実行環境 development / test / production（development）。
# NODE_ENV=development

# ログの下限レベル trace / debug / info / warn / error / fatal / silent（info）。
# LOG_LEVEL=info

# DB の接続方式 pg / pglite（pg）。pglite は PostgreSQL を用意せずに動かすためのもので、本番では使わない。
# pglite のデータは server/.pglite/ に残り、サーバーが起動のたびにマイグレーションを適用する（db:migrate は使わない）。
# DB_DRIVER=pg
