# main への push を止める。変更は作業ブランチから PR にする（.claude/rules/git-workflow.md）。
# GitHub にまだ main が無いとき（リポジトリを作った直後の最初の push）は通す。
# GitHub の main のファイルが、作成画面で付けられる README.md・LICENSE・.gitignore だけのときも、
# テンプレートを取り込む push（送るコミットにテンプレートの目印がある）だけは通す。
# 送り先のコミットが手元に無いときは、中身を確かめられないので断る。main を消す push も断る。
# 標準入力の 1 行が送る ref 1 つ: <手元の ref> <手元のコミット> <送り先の ref> <送り先のコミット>
# 送り先に無い ref のコミットと、消す ref の手元のコミットは 0 だけが並ぶ。
template_marker=".claude/rules/.standards-version"
repository_files='README\.md|LICENSE|\.gitignore'
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    case "$remote_oid" in
      *[!0]*)
        case "$local_oid" in
          *[!0]*)
            # 送り先のコミットが手元にあり、そのファイルが作成画面の 3 つだけ（ほかのファイルの行が無い）で、
            # 送るコミットにテンプレートの目印があるときだけ通す。ファイルの一覧を読めなければ、3 つに当たらない行を流して断る
            if git cat-file -e "$remote_oid^{commit}" 2>/dev/null &&
              ! { git ls-tree -r --name-only "$remote_oid" 2>/dev/null || echo "unreadable"; } | grep -qvxE "$repository_files" &&
              git cat-file -e "$local_oid:$template_marker" 2>/dev/null; then
              continue
            fi
            ;;
        esac
        echo "main には直接 push できません。作業ブランチ（feature/<Issue 番号>-<slug>。不具合の修正は fix/）を切って PR にしてください。" >&2
        if ! git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
          echo "送り先の main のコミットが手元に無いので、中身を確かめられませんでした。テンプレートをまだ取り込んでいないリポジトリなら、git fetch origin main の後に /shinnn-app:setup の手順に従ってください。" >&2
        fi
        exit 1
        ;;
    esac
  fi
done
