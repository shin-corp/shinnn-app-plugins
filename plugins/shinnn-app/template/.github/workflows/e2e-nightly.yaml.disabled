# 【無効】E2E テストの夜間実行
#
# このファイルは雛形です。拡張子 .disabled が付いている間、GitHub は読み込みません。
# 有効にするには /shinnn-app:setup を実行してください（Playwright の導入も setup が行います）。
# Playwright を入れていない状態でこのファイルを有効にすると失敗します。
#
# 費用: 無料（Actions の無料枠内）。
# 効果: 毎晩、画面を実際に操作するテストを流し、壊れていれば Issue が立ちます。
# 入れない場合: 画面の確認は PR ごとの単体テストと人の目視になります。
name: E2E（夜間）

on:
  schedule:
    - cron: '0 18 * * *'
  workflow_dispatch:

permissions:
  contents: read
  issues: write

jobs:
  e2e:
    name: E2E テスト
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-node@v7
        with:
          node-version: '24'
          cache: npm

      - run: npm ci

      - run: npm run build

      - run: npm exec -w client -- playwright install --with-deps chromium

      - run: npm run test:e2e -w client

      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: playwright-report
          path: client/playwright-report/
          retention-days: 7
