{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-edit.mjs"],
            "timeout": 15,
            "statusMessage": "編集してよい場所か確認しています"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard-bash.mjs"],
            "timeout": 15,
            "statusMessage": "コマンドの安全性を確認しています"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/format-file.mjs"],
            "timeout": 120,
            "statusMessage": "eslint --fix を掛けています"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/check-on-stop.mjs"],
            "timeout": 420,
            "statusMessage": "変更したファイルの lint と関連テストを確認しています"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs"],
            "timeout": 60,
            "statusMessage": "Issue と PR の状況を取得しています"
          }
        ]
      }
    ]
  }
}
