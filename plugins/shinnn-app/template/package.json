{
  "name": "shinnn-app-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run build -w shared && npm run check --workspaces --if-present",
    "test": "npm run build -w shared && npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run build -w shared && concurrently -n shared,server,client \"npm run dev -w shared\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "messages": "npm run messages -w server",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true,
    "unrs-resolver": true
  }
}
